# Dev-overlay Secret source (deploy/k8s/overlays/dev/secret.env).
# Copy to `secret.env`; every default below matches the dev addons — only
# the two crypto secrets need generating:
#
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
ENCRYPTION_PEPPER=

# In-cluster dev addon (addons/postgres). NOT for production.
DATABASE_URL=postgresql+asyncpg://openbull:openbull@postgres:5432/openbull

# In-cluster dev addon (addons/redis).
REDIS_URL=redis://redis:6379/0
