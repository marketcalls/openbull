# Per-instance Secret source for secretGenerator
# (deploy/k8s/overlays/<name>/secret.env).
#
# Copy to `secret.env`, fill in, never commit it (covered by
# deploy/k8s/.gitignore AND the root .dockerignore's recursive **/secret.env
# — building the image from a checkout with live secrets does not leak them
# into the image).
#
# Generate ONCE per instance, BEFORE the first boot, and back the values up
# (e.g. in a password manager):
#
#   APP_SECRET_KEY    -> python3 -c "import secrets; print(secrets.token_hex(32))"
#   ENCRYPTION_PEPPER -> python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Rotating APP_SECRET_KEY invalidates every login session (users just log in
# again). Rotating ENCRYPTION_PEPPER makes ALL stored broker credentials and
# API keys undecryptable — treat it as disaster recovery only.
#
# NEVER reuse these two values across instances.
APP_SECRET_KEY=
ENCRYPTION_PEPPER=

# PostgreSQL — externally managed (the k8s package does not deploy a
# production database). The app wants the asyncpg scheme; the migration
# runner converts it to psycopg automatically.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/openbull

# Redis — externally managed cache backend (rate limiting, symbol-cache
# hydration, strategy locks). Optional auth via redis://:password@host:6379/0.
REDIS_URL=redis://HOST:6379/0
