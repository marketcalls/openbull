# OpenBull production env — copy to `.env.prod` and fill in. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod && edit
# Generate each secret with: python -c "import secrets; print(secrets.token_hex(32))"

# ---- Core secrets (REQUIRED — unique per deployment) ----
APP_SECRET_KEY=change_me_64_hex
ENCRYPTION_PEPPER=change_me_64_hex

# ---- Postgres (compose service name = postgres) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=openbull
DATABASE_URL=postgresql+asyncpg://postgres:change_me_strong@postgres:5432/openbull

# ---- Redis (compose service name = redis) ----
REDIS_URL=redis://redis:6379/0

# ---- Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765
ZMQ_HOST=127.0.0.1
ZMQ_PORT=5555
FLASK_DEBUG=false

# ---- Public URL / CORS / TLS ----
# DOMAIN drives Caddy auto-HTTPS: set a real hostname pointed at this VM to get
# a free Let's Encrypt cert automatically; leave as ":80" for plain HTTP.
DOMAIN=:80
# Set these to your domain (or http://<VM_PUBLIC_IP>). Same-origin nginx means
# CORS is mostly moot, but keep them aligned with how the browser reaches the site.
FRONTEND_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example

# ---- Brokers ----
VALID_BROKERS=upstox

# ---- Rate limits / session ----
API_RATE_LIMIT=100 per minute
ORDER_RATE_LIMIT=10 per minute
LOGIN_RATE_LIMIT_MIN=5 per minute
LOGIN_RATE_LIMIT_HOUR=20 per hour
SESSION_EXPIRY_TIME=86400

# ---- WebSocket pooling ----
ENABLE_CONNECTION_POOLING=true
MAX_WEBSOCKET_CONNECTIONS=10
MAX_SYMBOLS_PER_WEBSOCKET=1000

# ---- Logging ----
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_DIR=logs
LOG_COLORS=false

# ---- Databricks (analytics sink; bare host, no https://) ----
DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
DATABRICKS_TOKEN=dapi_xxx
DATABRICKS_CATALOG=openbull
DATABRICKS_SCHEMA=openbull
DATABRICKS_STAGE_VOLUME=data
